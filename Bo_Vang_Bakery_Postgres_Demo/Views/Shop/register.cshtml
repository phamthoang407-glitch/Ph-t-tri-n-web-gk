@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using Web_barkery1.Models
@inject IAntiforgery Csrf
@inject UserManager<ApplicationUser> Users
@{
 Layout = null;
 var account = await Users.GetUserAsync(User);
 var role = User.IsInRole("ADMIN") ? "ADMIN" : "CUSTOMER";
 var current = account == null ? null : new { id=account.Id, full_name=account.FullName, email=account.Email, role=role };
}
<!DOCTYPE html>
<html lang="vi"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Đăng nhập | Bơ Vàng Bakery</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../css/style.css"><link rel="stylesheet" href="../css/header.css"><link rel="stylesheet" href="../css/auth.css"><link rel="stylesheet" href="../css/responsive.css">
<meta name="csrf-token" content="@Csrf.GetAndStoreTokens(Context).RequestToken" />
<script>window.BAKERY_USER = @Json.Serialize(current);</script>
<link rel="stylesheet" href="/css/bovang-modern.css?v=2">
<link rel="stylesheet" href="/css/mini-shared.css?v=1">
</head><body data-page="auth"><div id="header"></div>
<main class="auth-page">
<section class="auth-visual">
<img src="https://images.unsplash.com/photo-1519869325930-281384150729?auto=format&fit=crop&w=1200&q=90" alt="Bánh ngọt">
<div class="auth-overlay"><span class="eyebrow" style="color:#F3D8C3">WELCOME TO BAKERY</span><h1>Một chiếc bánh,<br>một niềm vui.</h1><p>Không gian mua bánh hiện đại, quản lý rõ ràng và trải nghiệm ngọt ngào.</p></div>
</section>
<section class="auth-form-wrap"><form class="auth-form" id="register-form">
<span class="eyebrow">TÀI KHOẢN</span><h2>Tạo tài khoản khách hàng</h2><p>Mật khẩu từ 8 ký tự, có chữ hoa, chữ thường và số.</p>
<div class="field"><label>HỌ VÀ TÊN</label><input id="full-name" required maxlength="100"></div><div class="field"><label>EMAIL</label><input id="login-user" type="email" required placeholder="example@@email.com"></div>
<div class="field"><label>MẬT KHẨU</label><input id="login-pass" type="password" required placeholder="••••••••"></div>
<button class="btn btn--primary" type="submit">Đăng ký →</button>
</form></section></main>
<div id="footer"></div><div id="toast" class="toast"></div><nav id="mobile-nav"></nav>
<script src="../js/api.js"></script><script src="../js/data.js"></script><script src="../js/main.js?v=4"></script><script src="../js/register.js"></script>
</body></html>