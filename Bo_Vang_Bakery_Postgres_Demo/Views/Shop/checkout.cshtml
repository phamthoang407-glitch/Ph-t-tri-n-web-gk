@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using Web_barkery1.Models
@inject IAntiforgery Csrf
@inject UserManager<ApplicationUser> Users
@{
 Layout = null;
 var account = await Users.GetUserAsync(User);
 var role = User.IsInRole("ADMIN") ? "ADMIN" : "CUSTOMER";
 var current = account == null ? null : new { id=account.Id, full_name=account.FullName, email=account.Email, role=role };
}
<!DOCTYPE html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Đặt hàng | Bơ Vàng Bakery</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../css/style.css"><link rel="stylesheet" href="../css/header.css"><link rel="stylesheet" href="../css/checkout.css"><link rel="stylesheet" href="../css/responsive.css"><meta name="csrf-token" content="@Csrf.GetAndStoreTokens(Context).RequestToken" />
<script>window.BAKERY_USER = @Json.Serialize(current);</script>
<link rel="stylesheet" href="/css/bovang-modern.css?v=2">
<link rel="stylesheet" href="/css/mini-shared.css?v=1">
</head>
<body data-page="cart"><div id="header"></div>
<section class="page-hero"><div class="container"><span class="eyebrow">CHECKOUT</span><h1>Đặt hàng</h1><p>Điền thông tin nhận bánh và xác nhận đơn hàng.</p></div></section>
<main class="container checkout-layout">
<section class="panel checkout-form"><div class="checkout-step"><span>01</span><div><b>Thông tin nhận hàng</b><small>Thông tin để nhân viên liên hệ khi giao bánh</small></div></div>
<div class="form-grid"><div class="field"><label>HỌ VÀ TÊN</label><input id="customer-name" required value=""></div><div class="field"><label>SỐ ĐIỆN THOẠI</label><input id="customer-phone" required value=""></div><div class="field full"><label>ĐỊA CHỈ GIAO HÀNG</label><input id="customer-address" required value=""></div></div>
<div class="checkout-step"><span>02</span><div><b>Phương thức thanh toán</b><small>Chọn một phương thức thuận tiện</small></div></div>
<label class="payment-option active"><input type="radio" name="payment" checked> <span>💵</span><div><b>Thanh toán khi nhận hàng</b><small>Thanh toán trực tiếp cho người giao</small></div></label>

<button class="btn btn--primary place-order" onclick="placeOrder()">Xác nhận đặt hàng</button>
</section>
<aside class="panel checkout-summary"><h3>Đơn hàng của bạn</h3><div id="checkout-items"></div><div class="summary-total"><span>Tổng cộng</span><strong id="checkout-total">0đ</strong></div></aside>
</main><div id="footer"></div><div id="toast" class="toast"></div><nav id="mobile-nav"></nav>
<script src="../js/api.js"></script><script src="../js/data.js"></script><script src="../js/main.js?v=4"></script><script src="../js/cart.js?v=4"></script><script src="../js/checkout.js"></script></body></html>