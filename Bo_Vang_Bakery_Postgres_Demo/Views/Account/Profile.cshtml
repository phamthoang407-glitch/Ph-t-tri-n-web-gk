@model ProfileViewModel
@{ ViewData["Title"] = "Thông tin cá nhân"; }
<h1>Thông tin cá nhân</h1><p>@User.Identity?.Name</p><form asp-action="Profile" method="post" class="panel form-panel"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName">Họ tên</label><input asp-for="FullName" class="form-control mb-3" /><label asp-for="PhoneNumber">Số điện thoại</label><input asp-for="PhoneNumber" class="form-control mb-3" /><label asp-for="Address">Địa chỉ</label><input asp-for="Address" class="form-control mb-3" /><button class="btn btn-primary" type="submit">Cập nhật thông tin</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
