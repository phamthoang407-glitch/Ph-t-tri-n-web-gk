@model List<Product>
@{ ViewData["Title"] = "Trang chủ"; }
<section class="hero"><p class="eyebrow">Bánh tươi · Mỗi ngày</p><h1>Bánh ngon cho<br /><em>mọi khoảnh khắc</em></h1><p class="my-4">Một chút ngọt ngào cho những cuộc gặp gỡ. Khám phá bánh tại quầy Vạn Phúc.</p><a class="btn btn-primary me-2" asp-controller="Products" asp-action="Index">Khám phá bánh →</a><a class="btn btn-light" asp-controller="Store" asp-action="Index">Vị trí quầy</a></section>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Bánh tại quầy</h2><a asp-controller="Products" asp-action="Index">Xem tất cả →</a></div>
@if (Model.Count == 0) { <div class="panel">Quầy đang cập nhật danh sách bánh.</div> }
<div class="product-grid">@foreach (var p in Model) { <article class="card"><img class="product-image" src="@(p.ImageUrl ?? "/images/cake-placeholder.svg")" alt="@p.Name" loading="lazy" /><div class="card-body"><small class="text-muted">@p.Category.Name</small><h3 class="h5 mt-2">@p.Name</h3><p class="mb-0">@p.Price.ToString("N0") đ</p></div></article> }</div>
