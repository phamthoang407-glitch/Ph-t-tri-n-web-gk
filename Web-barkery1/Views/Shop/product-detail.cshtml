@model Web_barkery1.Models.Product
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using Web_barkery1.Models
@inject IAntiforgery Csrf
@inject UserManager<ApplicationUser> Users
@{
 Layout = null;
 var account = await Users.GetUserAsync(User);
 var role = User.IsInRole("ADMIN") ? "ADMIN" : "CUSTOMER";
 var canonicalUrl = ViewData["CanonicalUrl"] as string;
 var pageTitle = Model == null ? "Chi tiết sản phẩm | Bơ Vàng Bakery" : $"{Model.Name} | Bơ Vàng Bakery";
 var pageDescription = Model == null ? "Khám phá các loại bánh ngon tại Bơ Vàng Bakery." : (string.IsNullOrWhiteSpace(Model.Description) ? $"{Model.Name} - xem giá và thông tin sản phẩm tại Bơ Vàng Bakery." : Model.Description);
 if (pageDescription.Length > 160) pageDescription = pageDescription[..157] + "...";
 var current = account == null ? null : new { id=account.Id, full_name=account.FullName, email=account.Email, role=role };
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@pageTitle</title>
<meta name="description" content="@pageDescription">
@if (!string.IsNullOrEmpty(canonicalUrl)) {
<link rel="canonical" href="@canonicalUrl">
<meta property="og:type" content="product">
<meta property="og:title" content="@pageTitle">
<meta property="og:description" content="@pageDescription">
<meta property="og:url" content="@canonicalUrl">
@if (!string.IsNullOrWhiteSpace(Model?.ImageUrl)) { <meta property="og:image" content="@(Model.ImageUrl!.StartsWith("http") ? Model.ImageUrl : $"{Context.Request.Scheme}://{Context.Request.Host}{(Model.ImageUrl.StartsWith('/') ? "" : "/")}{Model.ImageUrl}")"> }
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { context = "https://schema.org", type = "Product", name = Model!.Name, description = pageDescription, image = Model.ImageUrl, offers = new { type = "Offer", price = Model.Price, priceCurrency = "VND", url = canonicalUrl } }).Replace("\"context\"", "\"@context\"").Replace("\"type\"", "\"@type\""))</script>
}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/products.css">
  <link rel="stylesheet" href="/css/responsive.css">
<meta name="csrf-token" content="@Csrf.GetAndStoreTokens(Context).RequestToken" />
<script>window.BAKERY_USER = @Json.Serialize(current); window.BAKERY_PRODUCT_ID = @(Model?.Id ?? 0);</script>
<link rel="stylesheet" href="/css/bovang-modern.css?v=2">
<link rel="stylesheet" href="/css/mini-shared.css?v=1">
</head>
<body data-page="products">
<div id="header"></div>

<main class="container" style="padding:50px 0 80px"><a class="text-link" href="/san-pham">← Quay lại danh mục</a><div id="product-detail" style="margin-top:25px">@if (Model != null) {
 <article class="panel" style="padding:24px"><h1>@Model.Name</h1><p>@Model.Description</p><p>Giá: @Model.Price.ToString("N0")đ</p></article>
}</div></main>
<div id="footer"></div><div id="toast" class="toast"></div><nav id="mobile-nav"></nav>
<script src="/js/api.js"></script><script src="/js/data.js"></script><script src="/js/main.js?v=4"></script>
  <script src="/js/products.js?v=4"></script>
</body></html>
