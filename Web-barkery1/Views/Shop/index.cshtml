@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using Web_barkery1.Models
@inject IAntiforgery Csrf
@inject UserManager<ApplicationUser> Users
@{
 Layout = null;
 var account = await Users.GetUserAsync(User);
 var role = User.IsInRole("ADMIN") ? "ADMIN" : "CUSTOMER";
 var current = account == null ? null : new { id=account.Id, full_name=account.FullName, email=account.Email, role=role };

}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bơ Vàng Bakery - Bánh ngon cho mọi khoảnh khắc</title>
  <meta name="description" content="Bơ Vàng Bakery cung cấp bánh kem, bánh ngọt và bánh mì. Khám phá thực đơn, xem giá và đặt bánh tiện lợi.">
  <link rel="canonical" href="@( $"{Context.Request.Scheme}://{Context.Request.Host}/" )">
  <meta name="bakery-ui-version" content="2026-11-10-brand-refresh">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/header.css">
  <link rel="stylesheet" href="css/footer.css">
  <link rel="stylesheet" href="css/home.css">
  <link rel="stylesheet" href="css/responsive.css">
<meta name="csrf-token" content="@Csrf.GetAndStoreTokens(Context).RequestToken" />
<script>window.BAKERY_USER = @Json.Serialize(current);</script>
<link rel="stylesheet" href="/css/bovang-modern.css?v=2">
<link rel="stylesheet" href="/css/bovang-editorial-v3.css?v=3">
<link rel="stylesheet" href="/css/mini-shared.css?v=1">
</head>
<body data-page="home">
  <div id="header"></div>
  <main>
<section class="editorial-hero" aria-label="Giới thiệu Bơ Vàng Bakery">
  <div class="editorial-hero__copy">
    <div class="editorial-hero__topline"><span class="editorial-hero__spark">✳</span> BƠ VÀNG BAKERY <span class="editorial-hero__line"></span> FRESHLY BAKED</div>
    <p class="editorial-hero__intro">Tiệm bánh nhỏ, niềm vui to</p>
    <h1>Ngọt ngào<br><em>theo cách</em><br>của bạn<span class="editorial-hero__period">.</span></h1>
    <p class="editorial-hero__description">Bánh mềm thơm, hương vị tinh tế và những khoảnh khắc đáng yêu. Chọn chiếc bánh khiến hôm nay trở nên đặc biệt.</p>
    <div class="editorial-hero__actions">
      <a class="editorial-hero__cta" href="/san-pham">Đặt bánh ngay <span aria-hidden="true">↗</span></a>
      <a class="editorial-hero__secondary" href="#about">Câu chuyện Bơ Vàng <span aria-hidden="true">→</span></a>
    </div>
    <div class="editorial-hero__foot"><span>01 / BAKED WITH LOVE</span><span>CUỘN XUỐNG KHÁM PHÁ ↓</span></div>
  </div>
  <div class="editorial-hero__art">
    <img class="editorial-hero__photo" src="https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&amp;fit=crop&amp;w=1300&amp;q=85" alt="Bánh ngọt và tráng miệng" fetchpriority="high">
    <div class="editorial-hero__photo-shade"></div>
    <div class="editorial-hero__sticker"><span>✳</span><strong>MADE<br>WITH<br>LOVE</strong></div>
    <div class="editorial-hero__image-caption">BƠ VÀNG  /  EVERYDAY SWEETS</div>
  </div>
</section>
<section class="editorial-ticker" aria-label="Điểm nổi bật">
  <div><span>✳</span> BÁNH NGỌT MỖI NGÀY</div><div><span>✳</span> CHỌN BÁNH DỄ DÀNG</div><div><span>✳</span> ĐẶT HÀNG TRỰC TUYẾN</div><div><span>✳</span> THƯỞNG THỨC NIỀM VUI</div>
</section>

        <section class="section categories">
