<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · Bơ Vàng Bakery</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header><nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom"><div class="container">
<a class="navbar-brand brand" href="/">BƠ VÀNG <span>BAKERY</span></a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav ms-auto align-items-lg-center">
<li class="nav-item"><a class="nav-link" href="/">Trang chủ</a></li>
<li class="nav-item"><a class="nav-link" href="/san-pham">Sản phẩm</a></li>


@if (User.Identity?.IsAuthenticated == true) {
@if (User.IsInRole("ADMIN")) { <li class="nav-item"><a class="nav-link" href="/pages/dashboard-owner.html">Chủ quầy</a></li> }
<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Thông tin cá nhân</a></li>
<li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm" type="submit">Đăng xuất</button></form></li>
} else { <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a></li> }
</ul></div></div></nav></header>
<main class="container page-main">
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@RenderBody()
</main>
<footer class="site-footer"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>Bơ Vàng Bakery · Bánh ngon mỗi ngày</span><a href="/">Thông tin quầy</a></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
